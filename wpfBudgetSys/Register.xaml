<Window x:Class="wpfBudgetSys.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfBudgetSys"
        mc:Ignorable="d"
        Title="Register"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5" SpreadMethod="Pad">
                <GradientStop Color="#FFFFE78B" Offset="1"/>
                <GradientStop Color="#FFFECA03" Offset="0"/>
                <GradientStop Color="#FFFBE17C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Main Card -->
        <Border Width="680"
                Height="390"
                Background="#FF0E218E"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>

                <!-- Two Sections -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDE -->
                <Grid Grid.Column="0">

                    <Image Source="/Assets/logowwordclear.png"
                           Width="250"
                           Height="250"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                </Grid>

                <!-- RIGHT SIDE -->
                <Border Grid.Column="1"
                        Background="Gainsboro"
                        CornerRadius="20" HorizontalAlignment="Center" Width="340">

                    <StackPanel Margin="35,20,35,20">

                        <!-- Title -->
                        <TextBlock Text="Register"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <!-- Username -->
                        <TextBlock Text="Username"
                                   Margin="0,0,0,3"/>

                        <TextBox Style="{StaticResource SharedInputStyle}"
                                 Height="30"
                                 Margin="0,0,0,10"/>

                        <!-- Email -->
                        <TextBlock Text="Email"
                                   Margin="0,0,0,3"/>

                        <TextBox Style="{StaticResource SharedInputStyle}"
                                 Height="30"
                                 Margin="0,0,0,10"/>

                        <!-- Number -->
                        <TextBlock Text="Number"
                                   Margin="0,0,0,3"/>

                        <TextBox Style="{StaticResource SharedInputStyle}"
                                 Height="30"
                                 Margin="0,0,0,10"/>

                        <!-- Password -->
                        <TextBlock Text="Password"
                                   Margin="0,0,0,3"/>

                        <PasswordBox Style="{StaticResource SharedPasswordStyle}"
                                     Height="30"
                                     Margin="0,0,0,20"/>

                        <!-- Register Button -->
                        <Button Content="Register"
                                Height="35"
                                Background="#FF0E218E"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="RegisterButton_Click"/>


                    </StackPanel>

                </Border>

            </Grid>

        </Border>

    </Grid>
</Window>