<Window x:Class="wpfBudgetSys.View.RegisterWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:wpfBudgetSys.View.UserControls"
        Title="Bawal Gastos — Create account"
        Height="720" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppPageBrush}"
        Icon="/Assets/logowwordclear.png">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource AppHeroBannerStyle}" Margin="0,0,0,20" Padding="24,20">
            <StackPanel>
                <TextBlock Text="Create your account" FontSize="26" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Complete each section below. Your email must be verified before registration finishes."
                           FontSize="14" Foreground="#9CA3AF" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="620" HorizontalAlignment="Center">

                <Border Style="{StaticResource AppFormCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Personal information" Style="{StaticResource AppSectionTitleStyle}"/>
                        <TextBlock Text="Your legal name and contact phone." Style="{StaticResource AppSectionSubtitleStyle}" Margin="0,0,0,12"/>
                        <uc:LabeledTextBox InputLabel="First name *" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                        <uc:LabeledTextBox InputLabel="Middle name" Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"/>
                        <uc:LabeledTextBox InputLabel="Last name *" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                        <uc:LabeledTextBox InputLabel="Phone *" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppFormCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Email verification" Style="{StaticResource AppSectionTitleStyle}"/>
                        <TextBlock Text="We send a one-time code to confirm you own this email." Style="{StaticResource AppSectionSubtitleStyle}" Margin="0,0,0,12"/>
                        <uc:LabeledTextBox InputLabel="Email *" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Send verification code" Style="{StaticResource AppBackButtonStyle}" HorizontalAlignment="Left"
                                Margin="0,8,0,12" Command="{Binding SendOtpCommand}"/>
                        <uc:LabeledTextBox InputLabel="Verification code *" Text="{Binding OtpInput, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsOtpSent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppFormCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Login credentials" Style="{StaticResource AppSectionTitleStyle}"/>
                        <TextBlock Text="Choose a username and a strong password." Style="{StaticResource AppSectionSubtitleStyle}" Margin="0,0,0,12"/>
                        <uc:LabeledTextBox InputLabel="Username *" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                        <uc:LabeledTextBox InputLabel="Password *" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
                        <Border Background="{StaticResource AppInsetBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Password requirements" FontWeight="SemiBold" Foreground="{StaticResource AppNavyBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ReqLength}" FontSize="13" Foreground="#4B5563" Margin="0,2"/>
                                <TextBlock Text="{Binding ReqUpper}" FontSize="13" Foreground="#4B5563" Margin="0,2"/>
                                <TextBlock Text="{Binding ReqLower}" FontSize="13" Foreground="#4B5563" Margin="0,2"/>
                                <TextBlock Text="{Binding ReqDigit}" FontSize="13" Foreground="#4B5563" Margin="0,2"/>
                                <TextBlock Text="{Binding ReqSpecial}" FontSize="13" Foreground="#4B5563" Margin="0,2"/>
                            </StackPanel>
                        </Border>
                        <uc:LabeledTextBox InputLabel="Confirm password *" Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding PasswordsMatchText}" FontSize="13" Foreground="{StaticResource AppMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Button Content="Complete registration" Style="{StaticResource AppPrimaryButtonStyle}"
                        HorizontalAlignment="Stretch" MinWidth="0" Command="{Binding CompleteRegistrationCommand}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <TextBlock Text="Already have an account? " Foreground="{StaticResource AppMutedBrush}" VerticalAlignment="Center"/>
            <Button Content="Sign in" Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource AppNavyBrush}" FontWeight="SemiBold" Cursor="Hand"
                    Command="{Binding ShowLoginWindowCommand}"/>
        </StackPanel>
    </Grid>
</Window>
