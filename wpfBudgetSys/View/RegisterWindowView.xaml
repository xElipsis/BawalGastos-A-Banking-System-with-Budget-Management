<Window x:Class="wpfBudgetSys.View.RegisterWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfBudgetSys.View"
        xmlns:userControls="clr-namespace:wpfBudgetSys.View.UserControls"
        mc:Ignorable="d"
        Title="RegisterWindowView" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <Grid Background="#e6e6e6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Create Account"
                           FontSize="24"
                           FontWeight="DemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <Border Grid.Row="1" 
                        Padding="50"
                        Width="600"
                        Background="White"
                        BorderBrush="LightGray"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        CornerRadius="30">

                    <StackPanel>

                        <userControls:LabeledTextBox InputLabel="First Name"
                                             Text="{Binding FirstName}"/>
                        <userControls:LabeledTextBox InputLabel="Middle Name"
                                             Text="{Binding MiddleName}"/>
                        <userControls:LabeledTextBox InputLabel="Last Name"
                                             Text="{Binding LastName}"/>
                        <userControls:LabeledTextBox InputLabel="Email"
                                             Text="{Binding Email}"/>
                        <userControls:LabeledTextBox InputLabel="Phone#"
                                             Text="{Binding Phone}"/>
                        <userControls:LabeledTextBox InputLabel="Username"
                                             Text="{Binding Username}"/>
                        <userControls:LabeledTextBox InputLabel="Password"
                                             Text="{Binding Password}"/>
                        <userControls:LabeledTextBox InputLabel="Confirm Password"/>
                        <Button Content="Register Now"
                        Height="40"
                        Background="DarkBlue"
                        Foreground="White"
                        FontSize="20"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="0,50,0,0"
                        Command="{Binding RegisterUser}"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" 
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Already have an account? "
                               Margin="4, 0"/>
                    <Button Content="Login now!"
                            Command="{Binding ShowLoginWindow}"/>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
