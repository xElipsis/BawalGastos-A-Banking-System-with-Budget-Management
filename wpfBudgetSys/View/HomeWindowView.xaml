<Window x:Class="wpfBudgetSys.View.HomeWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Menu="clr-namespace:wpfBudgetSys.MVVM"
        mc:Ignorable="d"
        Title="Bawal Gastos" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized" Icon="/Assets/logowwordclear.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>

        <Grid Background="#060063">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,16,12,8">
                <Image Width="200" Source="/Assets/logowwordclear.png" HorizontalAlignment="Center"/>
                <TextBlock Text="Admin Console" Foreground="#DDEC00" FontWeight="Bold" FontSize="13" Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,4,0,8">

                    <!-- User navigation -->
                    <StackPanel Visibility="{Binding IsRegularUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowDashboardCommand}"
                                  IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Dashboard, Mode=TwoWay}">
                            <Grid>
                                <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/dashboard-100.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Dashboard" Style="{StaticResource Text_Style}"/>
                            </Grid>
                        </Menu:Btn>
                        <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowPayCommand}"
                                  IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Pay, Mode=TwoWay}">
                            <Grid>
                                <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/cash-100.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Pay" Style="{StaticResource Text_Style}"/>
                            </Grid>
                        </Menu:Btn>
                        <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowBudgetsCommand}"
                                  IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Budgets, Mode=TwoWay}">
                            <Grid>
                                <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/budget-100.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Budgets" Style="{StaticResource Text_Style}"/>
                            </Grid>
                        </Menu:Btn>
                        <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowAlertsCommand}"
                                  IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Alerts, Mode=TwoWay}">
                            <Grid>
                                <Grid Width="30" Height="30" Margin="22,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Rectangle Fill="White" Width="30" Height="30">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/alerts-100.png"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <Ellipse Width="9" Height="9" Fill="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"
                                             Visibility="{Binding UnreadAlertCount, Converter={StaticResource IntAtLeastToVisibilityConverter}}"/>
                                </Grid>
                                <TextBlock Text="Alerts" Style="{StaticResource Text_Style}"/>
                            </Grid>
                        </Menu:Btn>
                        <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowNotificationsCommand}"
                                  IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Notifications, Mode=TwoWay}">
                            <Grid>
                                <Grid Width="30" Height="30" Margin="22,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Rectangle Fill="White" Width="30" Height="30">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/notification-100.png"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <Ellipse Width="9" Height="9" Fill="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"
                                             Visibility="{Binding UnreadNotificationCount, Converter={StaticResource IntAtLeastToVisibilityConverter}}"/>
                                </Grid>
                                <TextBlock Text="Notifications" Style="{StaticResource Text_Style}"/>
                            </Grid>
                        </Menu:Btn>
                        <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowTransactionCommand}"
                                  IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Transactions, Mode=TwoWay}">
                            <Grid>
                                <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/transaction-100.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Transactions" Style="{StaticResource Text_Style}"/>
                            </Grid>
                        </Menu:Btn>
                        <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowSettingsCommand}"
                                  IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Settings, Mode=TwoWay}">
                            <Grid>
                                <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/settings-100.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Settings" Style="{StaticResource Text_Style}"/>
                            </Grid>
                        </Menu:Btn>
                    </StackPanel>

                    <!-- Admin navigation -->
                    <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowDashboardCommand}"
                                  IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Dashboard, Mode=TwoWay}">
                            <Grid>
                                <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/dashboard-100.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Dashboard" Style="{StaticResource Text_Style}"/>
                            </Grid>
                        </Menu:Btn>
                        <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowAdminUsersCommand}"
                                  IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Users, Mode=TwoWay}">
                            <Grid>
                                <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/users-100.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Users" Style="{StaticResource Text_Style}"/>
                            </Grid>
                        </Menu:Btn>
                        <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowAdminAccountsCommand}"
                                  IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Accounts, Mode=TwoWay}">
                            <Grid>
                                <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/accounts-100.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Accounts" Style="{StaticResource Text_Style}"/>
                            </Grid>
                        </Menu:Btn>
                        <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowAdminTransactionsCommand}"
                                  IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Transactions, Mode=TwoWay}">
                            <Grid>
                                <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/transactions-100.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Transactions" Style="{StaticResource Text_Style}"/>
                            </Grid>
                        </Menu:Btn>
                        <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowAdminNotificationsCommand}"
                                  IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Notifications, Mode=TwoWay}">
                            <Grid>
                                <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/notification-100.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Notifications" Style="{StaticResource Text_Style}"/>
                            </Grid>
                        </Menu:Btn>
                        <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowAdminReportsCommand}"
                                  IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Reports, Mode=TwoWay}">
                            <Grid>
                                <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/reports-100.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Reports" Style="{StaticResource Text_Style}"/>
                            </Grid>
                        </Menu:Btn>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,8,0,16">
                <Border Height="1" Background="#2a2a9a" Margin="12,0,12,8"/>
                <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding LogoutCommand}">
                    <Grid>
                        <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/logout-100.png"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="Logout" Style="{StaticResource Text_Style}"/>
                    </Grid>
                </Menu:Btn>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="{StaticResource AppPageBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Padding="20,20,20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="←  Back" Style="{StaticResource AppBackButtonStyle}"
                            Command="{Binding GoBackCommand}"
                            Visibility="{Binding ShowBackButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ViewTitle}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource AppNavyBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Row="1">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
