<Window x:Class="wpfBudgetSys.View.HomeWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfBudgetSys.View"
        xmlns:userControls="clr-namespace:wpfBudgetSys.View.UserControls"
        xmlns:Menu="clr-namespace:wpfBudgetSys.MVVM"
        mc:Ignorable="d"
        Title="HomeWindowView" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>

        <Grid Background="#060063">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"/>
                <RowDefinition Height="8.5*"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="BawalGastos"
                           FontSize="20"
                           HorizontalAlignment="Center" 
                           Foreground="#ddec00"
                           FontWeight="Bold"/>
            </StackPanel>
            
            <StackPanel Grid.Row="1">

                <!-- // Dashboard // -->
                
                <Menu:Btn Style="{StaticResource BtnStyle}"
                          Command="{Binding ShowDashboardCommand}"
                          IsChecked="True">

                    <Grid>

                        <Image Source="pack://application:,,,/Assets/Icons/dashboard-100.png"
                               Style="{StaticResource Image_Style}"/>

                        <TextBlock Text="Dashboard"
                                   Style="{StaticResource Text_Style}"/>
                    </Grid>
                    
                </Menu:Btn>

                <!-- // Deposit // -->
                
                <Menu:Btn Style="{StaticResource BtnStyle}"
                          Command="{Binding ShowDepositCommand}">

                    <Grid>

                        <Image Source="pack://application:,,,/Assets/Icons/plus-100.png"
                               Style="{StaticResource Image_Style}"/>

                        <TextBlock Text="Deposit"
                                   Style="{StaticResource Text_Style}"/>
                    </Grid>

                </Menu:Btn>

                <!-- // Withdraw // -->
                
                <Menu:Btn Style="{StaticResource BtnStyle}"
                          Command="{Binding ShowWithdrawCommand}">

                    <Grid>

                        <Image Source="pack://application:,,,/Assets/Icons/arrow-bottom_left_corner-100.png"
                               Style="{StaticResource Image_Style}"/>

                        <TextBlock Text="Withdraw"
                                   Style="{StaticResource Text_Style}"/>
                    </Grid>

                </Menu:Btn>

                <!-- // Transfer // -->
                
                <Menu:Btn Style="{StaticResource BtnStyle}"
                          Command="{Binding ShowTransferCommand}">

                    <Grid>

                        <Image Source="pack://application:,,,/Assets/Icons/arrow-top_right_corner-100.png"
                               Style="{StaticResource Image_Style}"/>

                        <TextBlock Text="Transfer"
                   Style="{StaticResource Text_Style}"/>
                    </Grid>

                </Menu:Btn>
                
                <!-- // Pay // -->

                <Menu:Btn Style="{StaticResource BtnStyle}"
                          Command="{Binding ShowPayCommand}">

                    <Grid>

                        <Image Source="pack://application:,,,/Assets/Icons/cash-100.png"
                               Style="{StaticResource Image_Style}"/>

                        <TextBlock Text="Pay"
                                   Style="{StaticResource Text_Style}"/>
                    </Grid>

                </Menu:Btn>
                
                <!-- // Transaction // -->

                <Menu:Btn Style="{StaticResource BtnStyle}"
                          Command="{Binding ShowTransactionCommand}">

                    <Grid>

                        <Image Source="pack://application:,,,/Assets/Icons/transaction-100.png"
                               Style="{StaticResource Image_Style}"/>

                        <TextBlock Text="Transaction"
                                   Style="{StaticResource Text_Style}"/>
                    </Grid>

                </Menu:Btn>
                
                <!-- // Settings // -->

                <Menu:Btn Style="{StaticResource BtnStyle}"
                          Command="{Binding ShowSettingsCommand}">

                    <Grid>

                        <Image Source="pack://application:,,,/Assets/Icons/settings-100.png"
                               Style="{StaticResource Image_Style}"/>

                        <TextBlock Text="Settings"
                                   Style="{StaticResource Text_Style}"/>
                    </Grid>

                </Menu:Btn>

            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="LightGray">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"/>
                <RowDefinition Height="8.5*"/>
            </Grid.RowDefinitions>

            <Border Background="Transparent"
                    Padding="20">

                <TextBlock Text="{Binding ViewTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"/>

            </Border>

            <Border Grid.Row="1"
                    Background="Transparent"
                    Padding="30"
                    BorderThickness="0">

                <ContentControl Content="{Binding CurrentView}" BorderThickness="0"/>

            </Border>
        </Grid>
    </Grid>
</Window>
