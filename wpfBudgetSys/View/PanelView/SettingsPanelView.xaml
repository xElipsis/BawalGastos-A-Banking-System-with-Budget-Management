<UserControl x:Class="wpfBudgetSys.View.PanelView.SettingsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfBudgetSys.View.PanelView"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" >
    <UserControl.Resources>
        <Style x:Key="SwitchCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="SwitchBorder"
                                    Width="40"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,8,0">
                                <Grid>
                                    <Ellipse x:Name="SwitchThumb"
                                             Width="18"
                                             Height="18"
                                             Fill="White"
                                             Margin="1"/>
                                </Grid>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="21,1,1,1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#ccc"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#EEE"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#CCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#ccc"/>
            <Setter Property="BorderBrush" Value="#888"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Button Content="Settings" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <CheckBox Content="CheckBox" HorizontalAlignment="Left" Margin="351,324,0,0" VerticalAlignment="Top" Style="{StaticResource SwitchCheckBoxStyle}" />
    </Grid>
</UserControl>
