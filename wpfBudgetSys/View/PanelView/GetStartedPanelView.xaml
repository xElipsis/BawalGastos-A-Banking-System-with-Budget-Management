<UserControl x:Class="wpfBudgetSys.View.PanelView.GetStartedPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:wpfBudgetSys.View.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="1200"
             d:DesignWidth="800"
             Background="{StaticResource AppPageBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="40,32,40,48">
        <StackPanel MaxWidth="720"
                    HorizontalAlignment="Center">

            <!-- Welcome banner -->
            <Border Style="{StaticResource AppHeroBannerStyle}">
                <StackPanel>
                    <Border Height="4"
                            Width="48"
                            CornerRadius="2"
                            Background="{StaticResource AppAccentBrush}"
                            Margin="0,0,0,16"
                            HorizontalAlignment="Left"/>
                    <TextBlock Text="Welcome to Bawal Gastos!"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <TextBlock Text="Let's set up your account, "
                                   FontSize="17"
                                   Foreground="#D1D5DB"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Fullname}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppAccentBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Complete the steps below to create your account and budget limits."
                               FontSize="14"
                               Foreground="#9CA3AF"
                               Margin="0,14,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Main form card -->
            <Border Style="{StaticResource AppFormCardStyle}">
                <StackPanel>
                    <!-- Account setup -->
                    <StackPanel>
                        <TextBlock Text="Account setup"
                                   Style="{StaticResource AppSectionTitleStyle}"/>
                        <TextBlock Text="Enter your account details and opening balance."
                                   Style="{StaticResource AppSectionSubtitleStyle}"/>

                        <Border Background="{StaticResource AppInsetBrush}"
                                CornerRadius="14"
                                Padding="24,20"
                                Margin="0,20,0,0"
                                BorderBrush="#E8EAEF"
                                BorderThickness="1">
                            <StackPanel>
                                <userControls:LabeledTextBox InputLabel="Account number"
                                                             Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="True"
                                                             Margin="0,0,0,16"/>
                                <TextBlock Text="Account type"
                                           Style="{StaticResource LabeledTextBoxLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding AccountTypes}"
                                          SelectedItem="{Binding AccountType}"
                                          Style="{StaticResource AppComboBoxStyle}"
                                          Margin="0,0,0,16"/>
                                <userControls:LabeledTextBox InputLabel="Initial deposit"
                                                             IsNumericOnly="True"
                                                             Text="{Binding InitialDeposit, UpdateSourceTrigger=PropertyChanged}"
                                                             ErrorMessage="Enter numbers only."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Separator Margin="0,32"
                               Background="#E5E7EB"/>

                    <!-- Budget categories -->
                    <StackPanel>
                        <TextBlock Text="Budget categories"
                                   Style="{StaticResource AppSectionTitleStyle}"/>
                        <TextBlock Text="Set monthly and daily spending limits per category. Add presets or create your own."
                                   Style="{StaticResource AppSectionSubtitleStyle}"/>

                        <Border Background="White"
                                BorderBrush="{StaticResource BudgetGridLineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Margin="0,20,0,0"
                                ClipToBounds="True">
                            <DataGrid x:Name="CategoryDataGrid"
                                      Style="{StaticResource BudgetCategoryDataGridStyle}"
                                      ItemsSource="{Binding Categories}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="False"
                                      MinHeight="120">

                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Category" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoryName}"
                                                               FontSize="14"
                                                               FontWeight="Medium"
                                                               Foreground="#1F2937"
                                                               VerticalAlignment="Center"/>
                                                    <Border Margin="10,0,0,0"
                                                            Padding="8,2"
                                                            CornerRadius="10"
                                                            Background="#EEF0FF"
                                                            Visibility="Collapsed">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="Preset"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#060063"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding IsDefault}"
                                                         Style="{StaticResource BudgetCategoryCellTextBoxStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Monthly limit" Width="1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MonthlyLimit, StringFormat=N2}"
                                                           FontSize="14"
                                                           Foreground="#374151"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding MonthlyLimit, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource BudgetCategoryCellTextBoxStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Daily limit" Width="1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DailyLimit, StringFormat=N2}"
                                                           FontSize="14"
                                                           Foreground="#374151"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding DailyLimit, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource BudgetCategoryCellTextBoxStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource BudgetCategoryRemoveButtonStyle}"
                                                        HorizontalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveCategoryCommand,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Add category -->
                        <Border Background="{StaticResource AppInsetBrush}"
                                CornerRadius="12"
                                Padding="16,14"
                                Margin="0,16,0,0"
                                BorderBrush="#E8EAEF"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Add category"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{StaticResource AppNavyBrush}"/>
                                    <TextBlock Text="Choose a preset or create a custom category."
                                               FontSize="12"
                                               Foreground="{StaticResource AppMutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="CategoryComboBox"
                                          Grid.Column="1"
                                          Style="{StaticResource AppComboBoxStyle}"
                                          ItemsSource="{Binding PresetCategories}"
                                          DisplayMemberPath="CategoryName"
                                          Margin="16,0,0,0"
                                          SelectionChanged="CategoryComboBox_SelectionChanged"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#DC2626"
                       FontSize="14"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,20,0,0"
                       MaxWidth="560"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Create account -->
            <Button Content="Create account"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    Command="{Binding CreateAccountCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
