<UserControl x:Class="wpfBudgetSys.View.PanelView.AlertsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="{StaticResource AppPageBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,32,40,48">
        <StackPanel MaxWidth="800" HorizontalAlignment="Center">

            <Border Style="{StaticResource AppHeroBannerStyle}">
                <StackPanel>
                    <Border Height="4" Width="48" CornerRadius="2" Background="{StaticResource AppAccentBrush}"
                            Margin="0,0,0,16" HorizontalAlignment="Left"/>
                    <TextBlock Text="Budget alerts" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Notifications when spending reaches 50%, 75%, 90%, or 100% of a monthly limit."
                               FontSize="14" Foreground="#9CA3AF" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppFormCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Your alerts" Style="{StaticResource AppSectionTitleStyle}"/>
                        <Button Grid.Column="1" Content="Refresh" Style="{StaticResource AppBackButtonStyle}"
                                Command="{Binding RefreshCommand}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Alerts}"
                                  Visibility="{Binding HasAlerts, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppInsetBrush}" CornerRadius="12"
                                        Padding="16,14" Margin="0,0,0,12" BorderBrush="#E8EAEF" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#EEF0FF" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding AlertType}" FontWeight="Bold" Foreground="{StaticResource AppNavyBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" FontSize="13" Foreground="#4B5563"
                                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding TriggeredAt, StringFormat='MMM d, yyyy h:mm tt'}"
                                                       FontSize="12" Foreground="{StaticResource AppMutedBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Mark read" Style="{StaticResource AppBackButtonStyle}"
                                                VerticalAlignment="Top" FontSize="12" Padding="12,6"
                                                Visibility="{Binding IsRead, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                Command="{Binding DataContext.MarkReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding HasAlerts, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Margin="24" HorizontalAlignment="Center">
                        <TextBlock Text="No alerts" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppNavyBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EmptyMessage, Mode=OneWay}" FontSize="13"
                                   Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="420" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
