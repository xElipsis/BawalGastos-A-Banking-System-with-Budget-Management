<UserControl x:Class="wpfBudgetSys.View.PanelView.AccountClosedPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppPageBrush}">
    <ScrollViewer Padding="40,32">
        <Border Style="{StaticResource AppFormCardStyle}" MaxWidth="640" HorizontalAlignment="Center">
            <StackPanel>
                <Border Background="#FEE2E2" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                    <TextBlock Text="Account closed" FontSize="22" FontWeight="Bold" Foreground="#991B1B"/>
                </Border>
                <TextBlock Text="{Binding AccountNumber, StringFormat='Account: {0}'}" FontWeight="SemiBold"
                           Foreground="{StaticResource AppNavyBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" Foreground="#4B5563" LineHeight="22"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
