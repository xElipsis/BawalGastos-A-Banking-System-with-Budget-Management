<UserControl x:Class="wpfBudgetSys.View.PanelView.TransactionPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="900"
             Background="{StaticResource AppPageBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="40,32,40,48">
        <StackPanel MaxWidth="800" HorizontalAlignment="Center">

            <Border Style="{StaticResource AppHeroBannerStyle}">
                <StackPanel>
                    <Border Height="4" Width="48" CornerRadius="2" Background="{StaticResource AppAccentBrush}"
                            Margin="0,0,0,16" HorizontalAlignment="Left"/>
                    <TextBlock Text="Transaction history" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="View all activity on your account."
                               FontSize="14" Foreground="#9CA3AF" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppFormCardStyle}">
                <StackPanel>
                    <TextBlock Text="Recent transactions" Style="{StaticResource AppSectionTitleStyle}"/>
                    <TextBlock Text="Deposits, withdrawals, transfers, and payments appear below."
                               Style="{StaticResource AppSectionSubtitleStyle}"/>

                    <Border Background="White"
                            BorderBrush="{StaticResource BudgetGridLineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="0,20,0,0"
                            ClipToBounds="True"
                            MinHeight="200">
                        <Grid>
                            <DataGrid Style="{StaticResource BudgetCategoryDataGridStyle}"
                                      ItemsSource="{Binding Transactions}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Visibility="{Binding HasTransactions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="*"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="*"/>
                                    <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="24"
                                        Visibility="{Binding HasTransactions, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <TextBlock Text="No transactions yet"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AppNavyBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding EmptyMessage, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{StaticResource AppMutedBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,8,0,0"
                                           MaxWidth="400"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
