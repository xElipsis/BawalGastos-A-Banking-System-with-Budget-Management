<UserControl x:Class="wpfBudgetSys.View.PanelView.BudgetsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="{StaticResource AppPageBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,32,40,48">
        <StackPanel MaxWidth="800" HorizontalAlignment="Center">

            <Border Style="{StaticResource AppHeroBannerStyle}">
                <StackPanel>
                    <Border Height="4" Width="48" CornerRadius="2" Background="{StaticResource AppAccentBrush}"
                            Margin="0,0,0,16" HorizontalAlignment="Left"/>
                    <TextBlock Text="Budget limits" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Manage spending limits per category."
                               FontSize="14" Foreground="#9CA3AF" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppFormCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Your budgets" Style="{StaticResource AppSectionTitleStyle}"/>
                            <TextBlock Text="Edit limits in the table, then save all changes at once."
                                       Style="{StaticResource AppSectionSubtitleStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh" Style="{StaticResource AppBackButtonStyle}"
                                Command="{Binding RefreshCommand}" VerticalAlignment="Top"/>
                    </Grid>

                    <Border Background="White" BorderBrush="{StaticResource BudgetGridLineBrush}"
                            BorderThickness="1" CornerRadius="12" Margin="0,20,0,0" ClipToBounds="True" MinHeight="160">
                        <DataGrid Style="{StaticResource BudgetCategoryDataGridStyle}"
                                  ItemsSource="{Binding Budgets}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Category" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="14" FontWeight="Medium" Foreground="#1F2937"/>
                                                <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="10" Background="#EEF0FF" Visibility="Collapsed">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="Preset" FontSize="11" FontWeight="SemiBold" Foreground="#060063"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsDefault}"
                                                     Style="{StaticResource BudgetCategoryCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Monthly" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MonthlyLimit, StringFormat=N2}" FontSize="14" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding MonthlyLimit, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource BudgetCategoryCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Daily" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DailyLimit, StringFormat=N2}" FontSize="14" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding DailyLimit, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource BudgetCategoryCellTextBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource BudgetCategoryRemoveButtonStyle}"
                                                    Command="{Binding DataContext.DeleteBudgetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Background="{StaticResource AppInsetBrush}" CornerRadius="12" Padding="16,14" Margin="0,16,0,0"
                            BorderBrush="#E8EAEF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Add a preset or custom category" FontWeight="SemiBold" Foreground="{StaticResource AppNavyBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="BudgetCategoryComboBox" Grid.Column="1" Style="{StaticResource AppComboBoxStyle}"
                                      ItemsSource="{Binding AvailablePresets}" DisplayMemberPath="CategoryName"
                                      Margin="16,0,0,0" SelectionChanged="BudgetCategoryComboBox_SelectionChanged"/>
                        </Grid>
                    </Border>

                    <Button Content="Save all budgets" Style="{StaticResource AppPrimaryButtonStyle}"
                            HorizontalAlignment="Right" Margin="0,20,0,0"
                            Command="{Binding SaveAllCommand}"/>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="#DC2626" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
