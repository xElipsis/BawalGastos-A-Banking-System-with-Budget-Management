<UserControl x:Class="wpfBudgetSys.View.PanelView.HomeWindowPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:wpfBudgetSys.View.PanelView"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border CornerRadius="25" 
                Background="White"
                Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="0.00php"
                           FontSize="36"
                           FontWeight="DemiBold"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Bottom"/>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="Deposit"
                            Width="100"
                            Height="40"
                            Margin="20,0"
                            Command="{Binding ShowDepositCommand}"/>
                    <Button Content="Withdraw"
                            Width="100"
                            Height="40"
                            Margin="20,0"
                            Command="{Binding ShowWithdrawCommand}"/>
                    <Button Content="Transfer"
                            Width="100"
                            Height="40"
                            Margin="20,0"
                            Command="{Binding ShowTransferCommand}"/>
                    <Button Content="Pay"
                            Width="100"
                            Height="40"
                            Margin="20,0"
                            Command="{Binding ShowPayCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
