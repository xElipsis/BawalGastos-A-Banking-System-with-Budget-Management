<UserControl x:Class="wpfBudgetSys.View.PanelView.PayPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:wpfBudgetSys.View.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="800"
             Background="{StaticResource AppPageBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="40,32,40,48">
        <StackPanel MaxWidth="680" HorizontalAlignment="Center">

            <Border Style="{StaticResource AppHeroBannerStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="14" Background="#1a1a7a" VerticalAlignment="Top">
                        <Rectangle Width="28" Height="28" Fill="{StaticResource AppAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/cash-100.png"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <Border Height="4" Width="48" CornerRadius="2" Background="{StaticResource AppAccentBrush}"
                                Margin="0,0,0,12" HorizontalAlignment="Left"/>
                        <TextBlock Text="Pay" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Pay bills or merchants from your account."
                                   FontSize="14" Foreground="#9CA3AF" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource AppFormCardStyle}">
                <StackPanel>
                    <TextBlock Text="Payment details" Style="{StaticResource AppSectionTitleStyle}"/>
                    <TextBlock Text="Choose a budget category and enter payment information."
                               Style="{StaticResource AppSectionSubtitleStyle}"/>
                    <Border Background="{StaticResource AppInsetBrush}" CornerRadius="14" Padding="24,20"
                            Margin="0,20,0,0" BorderBrush="#E8EAEF" BorderThickness="1">
                        <StackPanel>
                            <userControls:LabeledTextBox InputLabel="Account number"
                                                         Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,0,16"/>
                            <TextBlock Text="Budget category"
                                       Style="{StaticResource LabeledTextBoxLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      DisplayMemberPath="CategoryName"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      Margin="0,0,0,16"/>
                            <userControls:LabeledTextBox InputLabel="Payee / description"
                                                         Text="{Binding Payee, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,0,16"/>
                            <userControls:LabeledTextBox InputLabel="Amount"
                                                         IsNumericOnly="True"
                                                         Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                                         ErrorMessage="Enter a valid amount (numbers only)."/>
                        </StackPanel>
                    </Border>
                    <Border Background="#EEF0FF" CornerRadius="10" Padding="14,12" Margin="0,20,0,0"
                            BorderBrush="#D8DCF0" BorderThickness="1">
                        <TextBlock Text="Payments count toward your category spending limits."
                                   FontSize="13" Foreground="#374151" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Button Content="Confirm payment"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    Command="{Binding PayCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,28,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
