<Window x:Class="wpfBudgetSys.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:wpfBudgetSys.View.UserControls"
        Title="Bawal Gastos — Sign in"
        Height="560" Width="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource AppPageBrush}"
        Icon="/Assets/logowwordclear.png">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource AppHeroBannerStyle}" Margin="32" CornerRadius="20">
            <StackPanel VerticalAlignment="Center" Margin="40">
                <Image Source="/Assets/logowwordclear.png" Height="120" Width="120" HorizontalAlignment="Left" Margin="0,0,0,24"/>
                <TextBlock Text="Bawal Gastos" FontSize="36" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Track spending, set budgets, and stay on top of your money."
                           FontSize="15" Foreground="#9CA3AF" TextWrapping="Wrap" MaxWidth="380" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource AppFormCardStyle}" Margin="0,32,32,32" VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" Margin="8">
                <TextBlock Text="Sign in" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AppNavyBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="Welcome back. Enter your credentials to continue."
                           Style="{StaticResource AppSectionSubtitleStyle}" Margin="0,0,0,24"/>

                <uc:LabeledTextBox InputLabel="Username" Text="{Binding InputUsername, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <PasswordBox x:Name="MyPasswordBox" Height="42" Margin="0,0,0,20"
                             Padding="12,8" FontSize="14"
                             BorderBrush="#C5C9D6" BorderThickness="1"/>

                <Button Content="Sign in" Style="{StaticResource AppPrimaryButtonStyle}"
                        HorizontalAlignment="Stretch" MinWidth="0" Margin="0,0,0,16"
                        Command="{Binding LoginUserCommand}"
                        CommandParameter="{Binding ElementName=MyPasswordBox}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="New here? " Foreground="{StaticResource AppMutedBrush}" VerticalAlignment="Center"/>
                    <Button Content="Create an account" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource AppNavyBrush}" FontWeight="SemiBold" Cursor="Hand"
                            Command="{Binding ShowRegisterWindowCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
