<UserControl x:Class="wpfBudgetSys.View.Admin.PanelView.AdminNotificationsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uc="clr-namespace:wpfBudgetSys.View.UserControls"
             Background="{StaticResource AppPageBrush}">
    <ScrollViewer Padding="32">
        <Border Style="{StaticResource AppFormCardStyle}" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel>
                <CheckBox Content="Send to all users (system-wide)" IsChecked="{Binding SendToAllUsers}" Margin="0,0,0,16"/>
                <TextBlock Text="Recipient" Style="{StaticResource AppSectionSubtitleStyle}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Users}" DisplayMemberPath="FullName" SelectedValuePath="UserId"
                          SelectedValue="{Binding SelectedUserId}" Style="{StaticResource AppComboBoxStyle}"/>
                <uc:LabeledTextBox InputLabel="Title" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0"/>
                <uc:LabeledTextBox InputLabel="Message" Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"/>
                <uc:LabeledTextBox InputLabel="Type" Text="{Binding NotificationType, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Send notification" Style="{StaticResource AppPrimaryButtonStyle}" Margin="0,16,0,0"
                        HorizontalAlignment="Left" Command="{Binding SendCommand}"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
