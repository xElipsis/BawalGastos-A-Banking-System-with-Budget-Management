<UserControl x:Class="wpfBudgetSys.View.Admin.PanelView.AdminReportsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppPageBrush}">
    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="480">
            <TextBlock Text="Generate read-only reports (Crystal Reports PDF export)." Style="{StaticResource AppSectionSubtitleStyle}" Margin="0,0,0,20"/>
            <Button Content="Transaction report" Style="{StaticResource AppPrimaryButtonStyle}" Margin="0,0,0,12"
                    HorizontalAlignment="Stretch" MinWidth="0" Command="{Binding TransactionReportCommand}"/>
            <Button Content="Account statement" Style="{StaticResource AppPrimaryButtonStyle}" Margin="0,0,0,12"
                    HorizontalAlignment="Stretch" MinWidth="0" Command="{Binding AccountStatementCommand}"/>
            <Button Content="Overspending report" Style="{StaticResource AppPrimaryButtonStyle}"
                    HorizontalAlignment="Stretch" MinWidth="0" Command="{Binding OverspendingReportCommand}"/>
            <TextBlock Text="Admins cannot modify balances, deposit, withdraw, view passwords, or delete transactions."
                       Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,24,0,0" FontSize="13"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
