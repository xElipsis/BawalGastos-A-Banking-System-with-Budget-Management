<UserControl x:Class="wpfBudgetSys.View.Admin.PanelView.AdminTransactionsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppPageBrush}">
    <ScrollViewer Padding="24">
        <StackPanel>
            <Border Style="{StaticResource AppFormCardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="From" FontSize="12" Foreground="{StaticResource AppMutedBrush}"/>
                        <DatePicker SelectedDate="{Binding FilterFrom}" Height="36"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="To" FontSize="12" Foreground="{StaticResource AppMutedBrush}"/>
                        <DatePicker SelectedDate="{Binding FilterTo}" Height="36"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Account #" FontSize="12" Foreground="{StaticResource AppMutedBrush}"/>
                        <TextBox Text="{Binding FilterAccountNumber, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6"/>
                    </StackPanel>
                    <Button Grid.Column="3" Content="Search" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="120" Height="40"
                            VerticalAlignment="Bottom" Command="{Binding SearchCommand}"/>
                </Grid>
            </Border>
            <DataGrid ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" CanUserAddRows="False"
                      Style="{StaticResource BudgetCategoryDataGridStyle}" MinHeight="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=g}" Width="*"/>
                    <DataGridTextColumn Header="Owner" Binding="{Binding OwnerName}" Width="*"/>
                    <DataGridTextColumn Header="Account" Binding="{Binding AccountNumber}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="60"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="*"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Flagged" Binding="{Binding IsFlagged}" Width="60" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Flag" Style="{StaticResource AppBackButtonStyle}" Padding="8,4" Margin="0,0,4,0" FontSize="11"
                                            Command="{Binding DataContext.FlagCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    <Button Content="Clear" Style="{StaticResource AppBackButtonStyle}" Padding="8,4" FontSize="11"
                                            Command="{Binding DataContext.UnflagCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
