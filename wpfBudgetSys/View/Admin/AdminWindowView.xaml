<Window x:Class="wpfBudgetSys.View.Admin.AdminWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Menu="clr-namespace:wpfBudgetSys.MVVM"
        Title="Bawal Gastos — Admin" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Icon="/Assets/logowwordclear.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>

        <Grid Background="#060063">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,16,12,8">
                <Image Height="48" Width="48" Source="/Assets/logowwordclear.png" HorizontalAlignment="Left"/>
                <TextBlock Text="Admin Console" Foreground="#DDEC00" FontWeight="Bold" FontSize="14" Margin="0,8,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowDashboardCommand}"
                              IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Dashboard, Mode=TwoWay}">
                        <Grid>
                            <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/dashboard-100.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Dashboard" Style="{StaticResource Text_Style}"/>
                        </Grid>
                    </Menu:Btn>
                    <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowUsersCommand}"
                              IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Users, Mode=TwoWay}">
                        <Grid>
                            <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/users-100.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Users" Style="{StaticResource Text_Style}"/>
                        </Grid>
                    </Menu:Btn>
                    <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowAccountsCommand}"
                              IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Accounts, Mode=TwoWay}">
                        <Grid>
                            <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/accounts-100.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Accounts" Style="{StaticResource Text_Style}"/>
                        </Grid>
                    </Menu:Btn>
                    <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowTransactionsCommand}"
                              IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Transactions, Mode=TwoWay}">
                        <Grid>
                            <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/transactions-100.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Transactions" Style="{StaticResource Text_Style}"/>
                        </Grid>
                    </Menu:Btn>
                    <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowNotificationsCommand}"
                              IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Notifications, Mode=TwoWay}">
                        <Grid>
                            <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/notification-100.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Notifications" Style="{StaticResource Text_Style}"/>
                        </Grid>
                    </Menu:Btn>
                    <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding ShowReportsCommand}"
                              IsChecked="{Binding SelectedNav, Converter={StaticResource NavMatchConverter}, ConverterParameter=Reports, Mode=TwoWay}">
                        <Grid>
                            <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/reports-100.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Reports" Style="{StaticResource Text_Style}"/>
                        </Grid>
                    </Menu:Btn>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,8,0,16">
                <Border Height="1" Background="#2a2a9a" Margin="12,0,12,8"/>
                <Menu:Btn Style="{StaticResource BtnStyle}" Command="{Binding LogoutCommand}">
                    <Grid>
                        <Rectangle Fill="White" Style="{StaticResource Image_Style}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://application:,,,/Assets/Icons/logout-100.png"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="Logout" Style="{StaticResource Text_Style}"/>
                    </Grid>
                </Menu:Btn>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="{StaticResource AppPageBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Padding="20,20,20,12">
                <TextBlock Text="{Binding ViewTitle}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AppNavyBrush}"/>
            </Border>
            <Border Grid.Row="1">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
