<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppNavyBrush" Color="#060063"/>
    <SolidColorBrush x:Key="AppAccentBrush" Color="#DDEC00"/>
    <SolidColorBrush x:Key="AppMutedBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="AppPageBrush" Color="#F0F2F8"/>
    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#E2E4EC"/>
    <SolidColorBrush x:Key="AppInsetBrush" Color="#F7F8FC"/>

    <Style x:Key="AppSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AppNavyBrush}"/>
    </Style>

    <Style x:Key="AppSectionSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="AppComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#C5C9D6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AppPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="52"/>
        <Setter Property="MinWidth" Value="280"/>
        <Setter Property="Padding" Value="32,0"/>
        <Setter Property="Background" Value="{StaticResource AppNavyBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#0a0080"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#04004a"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppHeroBannerStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,24"/>
        <Setter Property="Padding" Value="32,28"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#060063" Offset="0"/>
                    <GradientStop Color="#0a0080" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2" Color="#060063"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppFormCardStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="36,32"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.06" Color="#060063"/>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
