<Window x:Class="wpfBudgetSys.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfBudgetSys"
        mc:Ignorable="d"
        Title="LoginPage" Height="450" Width="800">
    <Grid Background="#FFE6E6E6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Rectangle Height="350" Margin="4,0,12,0" VerticalAlignment="Center" Fill="#FF0E218E" RadiusX="20" RadiusY="20" RenderTransformOrigin="0.5,0.5" Stroke="#FFEDB332" Grid.Column="1">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="-0.112"/>
                    <RotateTransform/>
                    <TranslateTransform Y="-0.623"/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Grid.Column="1" HorizontalAlignment="Left" Height="350" Margin="382,41,0,0" VerticalAlignment="Top" Width="210" Fill="#FF0078D4" Stroke="#FFFDC703"/>
        <Image HorizontalAlignment="Left" Height="294" Margin="26,0,0,0" VerticalAlignment="Center" Width="296" Source="/ChatGPT_Image_May_5__2026__09_36_31_PM-removebg-preview.png" Grid.Column="1"/>
        <TextBox Style="{StaticResource SharedInputStyle}" HorizontalAlignment="Left" Margin="405,182,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="160" Grid.Column="1" Height="30"/>
        <PasswordBox x:Name="MyPasswordBox" Style="{StaticResource SharedInputStyle}" HorizontalAlignment="Left" Margin="405,246,0,0" VerticalAlignment="Top" Width="160" Grid.Column="1" Height="30"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="Enter Username" VerticalAlignment="Top" Foreground="White" FontSize="14" Margin="413,158,0,0" Grid.Column="1" Height="19" Width="98"/>
        <TextBlock HorizontalAlignment="Left" Margin="413,222,0,0" TextWrapping="Wrap" Text="Enter Password" VerticalAlignment="Top" Foreground="White" FontSize="14" Grid.Column="1" Height="19" Width="94"/>
        <Button Content="Login" HorizontalAlignment="Left" Margin="470,286,0,0" VerticalAlignment="Top" Height="37" Width="95" BorderBrush="{x:Null}" Foreground="White" FontWeight="Bold" Grid.Column="1">
            <Button.Background>
                <ImageBrush ImageSource="/loginbutton-removebg-preview.png"/>
            </Button.Background>
        </Button>
        <Label Grid.Column="1" Content="Sign In" HorizontalAlignment="Left" Margin="439,96,0,0" VerticalAlignment="Top" Foreground="White" FontSize="25" FontWeight="Bold"/>

    </Grid>
</Window>
