<Window x:Class="wpfBudgetSys.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoginPage"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                <GradientStop Color="#FFFFE78B" Offset="1"/>
                <GradientStop Color="#FFFFC603" Offset="0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Center container -->
        <Border Width="650" Height="350"
                CornerRadius="20"
                Background="#FF0E218E"
                BorderBrush="#FFEDB332"
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Image -->
                <Grid Grid.Column="0">
                    <Image Source="/Assets/logowwordclear.png"
                           Width="250"
                           Height="250"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Grid>

                <!-- RIGHT: Login Form -->
                <Grid Grid.Column="1" Margin="20">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Sign In"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Enter Username"
                                   Foreground="White"
                                   FontSize="14"/>

                        <TextBox Style="{StaticResource SharedInputStyle}"
                                 Height="30"
                                 Margin="0,5,0,15"/>

                        <TextBlock Text="Enter Password"
                                   Foreground="White"
                                   FontSize="14"/>

                        <PasswordBox x:Name="MyPasswordBox"
                                     Style="{StaticResource SharedInputStyle}"
                                     Height="30"
                                     Margin="0,5,0,20"/>

                        <Button Content="Login"
                                Height="48"
                                Width="132"
                                HorizontalAlignment="Center"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderBrush="{x:Null}"
                                Click="Button_Click">

                            <Button.Background>
                                <ImageBrush ImageSource="/Assets/loginbutton-removebg-preview.png"/>
                            </Button.Background>

                        </Button>

                        <Button Content="To Register"
                                HorizontalAlignment="Center"
                                Click="ToRegisterButton_Click"/>

                    </StackPanel>

                </Grid>
            </Grid>

        </Border>

    </Grid>
</Window>