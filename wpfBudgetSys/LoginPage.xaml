<Window x:Class="wpfBudgetSys.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfBudgetSys"
        mc:Ignorable="d"
        Title="LoginPage" Height="450" Width="800">
    <Grid Background="#FFE6E6E6">
        <Rectangle Height="350" Margin="100,0,100,0" VerticalAlignment="Center" Fill="#FF0E218E" RadiusX="20" RadiusY="20" RenderTransformOrigin="0.5,0.5" Stroke="#FFEDB332">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="-0.112"/>
                    <RotateTransform/>
                    <TranslateTransform Y="-0.623"/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Image HorizontalAlignment="Center" Height="150" Margin="0,62,0,0" VerticalAlignment="Top" Width="150" Source="/ChatGPT_Image_May_5__2026__09_36_31_PM-removebg-preview.png"/>
        <TextBox Style="{StaticResource SharedInputStyle}" HorizontalAlignment="Center" Margin="0,231,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="160"/>
        <PasswordBox x:Name="MyPasswordBox" Style="{StaticResource SharedInputStyle}" HorizontalAlignment="Center" Margin="0,307,0,0" VerticalAlignment="Top" Width="160"/>
        <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Text="Enter Username" VerticalAlignment="Center" Foreground="White" FontSize="14"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,283,0,0" TextWrapping="Wrap" Text="Enter Password" VerticalAlignment="Top" Foreground="White" FontSize="14"/>

    </Grid>
</Window>
