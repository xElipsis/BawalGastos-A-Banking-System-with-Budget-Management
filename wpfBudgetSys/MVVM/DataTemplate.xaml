                    xmlns:PanelView="clr-namespace:wpfBudgetSys.View.PanelView"
                    xmlns:PanelVM="clr-namespace:wpfBudgetSys.ViewModel.PanelViewModel">

    <DataTemplate DataType="{x:Type PanelVM:GetStartedPanelVM}">
        <PanelView:GetStartedPanelView/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type PanelVM:HomeWindowPanelVM}">
        <PanelView:HomeWindowPanelView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type PanelVM:DepositPanelVM}">
        <PanelView:DepositPanelView/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type PanelVM:WithdrawPanelVM}">
        <PanelView:WithdrawPanelView/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type PanelVM:TransferPanelVM}">
        <PanelView:TransferPanelView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type PanelVM:SettingsPanelVM}">
        <PanelView:SettingsPanelView/>
    </DataTemplate>

    <!-- FIX: Only include this DataTemplate if TransactionPanelView exists in the namespace.
