    <!--
    <DataTemplate DataType="{x:Type PanelVM:TransactionPanelVM}">
        <PanelView:TransactionPanelView/>
    </DataTemplate>
    -->

    <DataTemplate DataType="{x:Type PanelVM:PayPanelVM}">
